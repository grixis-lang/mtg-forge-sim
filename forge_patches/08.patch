diff --git a/forge-ai/src/main/java/forge/ai/LifeOrDiscard.java b/forge-ai/src/main/java/forge/ai/LifeOrDiscard.java
new file mode 100644
index 0000000..081f3c3
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/LifeOrDiscard.java
@@ -0,0 +1,208 @@
+package forge.ai;
+
+// ---------------------------------------------------------------------------
+// Imports
+// ---------------------------------------------------------------------------
+import java.util.EnumSet;
+import java.util.Set;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+import forge.game.GameEntity;
+import forge.game.ability.ApiType;
+import forge.game.card.Card;
+import forge.game.card.CardCollection;
+import forge.game.cost.Cost;
+import forge.game.cost.CostDiscard;
+import forge.game.cost.CostPayLife;
+import forge.game.keyword.KeywordInterface;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+
+/**
+ * "Pay life or discard?" for spells like Bitter Triumph ("As an additional cost, discard a
+ * card or pay 3 life"). AI profile property LIFE_OR_DISCARD_SMART=true.
+ *
+ * The user's rule (rule 5 in notes/how_we_play_control.md):
+ *   1. Early game (our turns 2-4) with a healthy life total: pay the life, keep the cards.
+ *   2. Otherwise discard a card we don't need (a spare land, or a spell that isn't a
+ *      threat or an answer). Never discard a key card (a win condition or an answer).
+ *   3. If only key cards are left: pay the life, but ONLY if we survive the turn
+ *      (life after paying > what the opponent's creatures can hit us for).
+ *   4. If paying would put us in lethal range: discard the least valuable card instead.
+ *
+ * Forge treats the two choices as two versions of the spell. The AI asks "will I pay this
+ * cost?" for each version (SpellAbilityAi.willPayCosts); with this rule on, only the
+ * version matching the decision says yes, and AiCostDecision discards the chosen card.
+ * Off by default, so only decks whose profile turns it on are affected.
+ */
+public final class LifeOrDiscard {
+
+    private LifeOrDiscard() {
+    }
+
+    public enum Pick { PAY_LIFE, DISCARD }
+
+    // the decision: what to do, and which card to discard (null when paying life)
+    public record Decision(Pick pick, Card discard) { }
+
+    private static final Pattern PAY_LIFE = Pattern.compile("PayLife<(\\d+)>");
+    private static final int HEALTHY_LIFE_AFTER = 10;   // "healthy": still at 10+ life after paying
+    private static final int EARLY_TURNS = 4;           // "early game": our turns 1-4
+    private static final int ENOUGH_LANDS = 5;          // with 5+ lands in play, a land in hand is spare
+
+    // effects that make a card an "answer" (never discard it unless we must)
+    private static final Set<ApiType> ANSWERS = EnumSet.of(ApiType.Counter, ApiType.Destroy, ApiType.DestroyAll,
+            ApiType.ChangeZone, ApiType.ChangeZoneAll, ApiType.Sacrifice, ApiType.SacrificeAll,
+            ApiType.DealDamage, ApiType.DamageAll, ApiType.Tap, ApiType.TapAll);
+
+    // -----------------------------------------------------------------------
+    // 1. Does this rule apply? (setting on, and the spell offers "pay N life OR discard")
+    //    Returns the life amount, or -1 when it doesn't apply.
+    // -----------------------------------------------------------------------
+    private static int lifeChoiceAmount(final Player ai, final Card host) {
+        if (host == null || !(ai.getController() instanceof PlayerControllerAi pc)
+                || !pc.getAi().getBoolProperty(AiProps.LIFE_OR_DISCARD_SMART)) {
+            return -1;
+        }
+        for (final KeywordInterface k : host.getKeywords()) {
+            final String kw = k.getOriginal();
+            if (kw.startsWith("AlternateAdditionalCost") && kw.contains("Discard<")) {
+                final Matcher m = PAY_LIFE.matcher(kw);
+                if (m.find()) {
+                    return Integer.parseInt(m.group(1));
+                }
+            }
+        }
+        return -1;
+    }
+
+    // -----------------------------------------------------------------------
+    // 2. The decision itself (null = rule doesn't apply, use Forge's normal logic)
+    // -----------------------------------------------------------------------
+    public static Decision decide(final Player ai, final SpellAbility sa) {
+        final Card host = sa.getHostCard();
+        final int lifeCost = lifeChoiceAmount(ai, host);
+        if (lifeCost < 0) {
+            return null;
+        }
+        final int lifeAfter = ai.getLife() - lifeCost;
+        final boolean survives = lifeAfter > damageWeCouldTake(ai, sa);
+        final boolean early = ai.getTurn() <= EARLY_TURNS;
+
+        // 2a. early game, healthy life: pay life, keep the cards
+        if (early && survives && lifeAfter >= HEALTHY_LIFE_AFTER) {
+            return new Decision(Pick.PAY_LIFE, null);
+        }
+        // 2b. a card we don't need: discard it
+        final CardCollection hand = handWithout(ai, host);
+        final Card junk = spareCard(ai, hand);
+        if (junk != null) {
+            return new Decision(Pick.DISCARD, junk);
+        }
+        // 2c. only key cards left: pay life if we survive the turn
+        if (survives) {
+            return new Decision(Pick.PAY_LIFE, null);
+        }
+        // 2d. paying would put us in lethal range: give up the least valuable card
+        final Card least = ComputerUtilCard.getWorstAI(hand);
+        if (least != null) {
+            return new Decision(Pick.DISCARD, least);
+        }
+        return new Decision(Pick.PAY_LIFE, null);   // empty hand: paying is the only way
+    }
+
+    // -----------------------------------------------------------------------
+    // 3. Used by SpellAbilityAi.willPayCosts:
+    //    null  = rule doesn't apply (keep Forge's normal checks)
+    //    TRUE  = this version of the spell is the one we chose (skip Forge's life threshold)
+    //    FALSE = this is the other version (don't use it)
+    // -----------------------------------------------------------------------
+    public static Boolean acceptsVersion(final Player ai, final SpellAbility sa, final Cost cost) {
+        // only the spell's own cost (not e.g. a ward cost checked for the same spell)
+        if (cost == null || cost != sa.getPayCosts()) {
+            return null;
+        }
+        final boolean paysLife = cost.hasSpecificCostType(CostPayLife.class);
+        final boolean discards = cost.hasSpecificCostType(CostDiscard.class);
+        if (paysLife == discards) {
+            return null;   // not one of the two versions
+        }
+        final Decision d = decide(ai, sa);
+        if (d == null) {
+            return null;
+        }
+        return paysLife == (d.pick() == Pick.PAY_LIFE);
+    }
+
+    // -----------------------------------------------------------------------
+    // 4. Used by AiCostDecision when paying the discard: which card (null = Forge decides)
+    // -----------------------------------------------------------------------
+    public static Card cardToDiscard(final Player ai, final SpellAbility sa) {
+        final Decision d = decide(ai, sa);
+        return d != null && d.pick() == Pick.DISCARD ? d.discard() : null;
+    }
+
+    // -----------------------------------------------------------------------
+    // 5. How much the opponent's creatures could hit us for on their next turn
+    //    (all their creatures, ignoring our blockers: the safe estimate), minus the
+    //    creature this spell is about to kill.
+    // -----------------------------------------------------------------------
+    private static int damageWeCouldTake(final Player ai, final SpellAbility sa) {
+        int total = 0;
+        for (final Player opp : ai.getOpponents()) {
+            for (final Card c : opp.getCreaturesInPlay()) {
+                total += Math.max(0, c.getNetCombatDamage());
+            }
+        }
+        for (final GameEntity t : sa.getTargets().getTargetEntities()) {
+            if (t instanceof Card c && c.isCreature() && !ai.equals(c.getController())) {
+                total -= Math.max(0, c.getNetCombatDamage());
+            }
+        }
+        return Math.max(0, total);
+    }
+
+    // -----------------------------------------------------------------------
+    // 6. A card we don't need: a spare land first, then a spell that is neither a
+    //    threat (creature/planeswalker) nor an answer. Null if every card is key.
+    // -----------------------------------------------------------------------
+    private static Card spareCard(final Player ai, final CardCollection hand) {
+        final int landsInPlay = ai.getLandsInPlay().size();
+        final long landsInHand = hand.stream().filter(Card::isLand).count();
+        Card bestSpell = null;
+        for (final Card c : hand) {
+            if (c.isLand()) {
+                // a land is spare when we already have enough, or hold another one
+                if (landsInPlay >= ENOUGH_LANDS || landsInHand >= 2) {
+                    return c;
+                }
+            } else if (!isKey(c) && (bestSpell == null || c.getCMC() < bestSpell.getCMC())) {
+                bestSpell = c;
+            }
+        }
+        return bestSpell;
+    }
+
+    // a win condition (creature, planeswalker) or an answer (removal, counter, tapper, wipe)
+    private static boolean isKey(final Card c) {
+        if (c.isCreature() || c.isPlaneswalker()) {
+            return true;
+        }
+        for (final SpellAbility sa : c.getSpellAbilities()) {
+            for (SpellAbility part = sa; part != null; part = part.getSubAbility()) {
+                if (part.getApi() != null && ANSWERS.contains(part.getApi())) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    private static CardCollection handWithout(final Player ai, final Card host) {
+        final CardCollection hand = new CardCollection(ai.getCardsIn(ZoneType.Hand));
+        hand.remove(host);
+        return hand;
+    }
+}
