+    /** Replace a player's deck for the next game with its sideboarded version (main deck and sideboard). */
+    private static void switchDeck(final Deck current, final Deck sideboarded) {
+        current.getMain().clear();
+        current.getMain().addAll(sideboarded.getMain());
+        final CardPool side = current.getOrCreate(DeckSection.Sideboard);
+        side.clear();
+        if (sideboarded.has(DeckSection.Sideboard)) {
+            side.addAll(sideboarded.get(DeckSection.Sideboard));
+        }
+    }
+
+    /** One line per match, e.g. "Match Result: Match 3 | Ai(1)-x 2 | Ai(2)-y 1 | draws 0". */
+    private static void printMatchResult(final Match match, final int iMatch, final List<RegisteredPlayer> pp) {
+        final StringBuilder sb = new StringBuilder("Match Result: Match ").append(iMatch + 1);
+        for (RegisteredPlayer rp : pp) {
+            sb.append(" | ").append(rp.getPlayer().getName()).append(' ').append(match.getGamesWonBy(rp.getPlayer()));
+        }
+        int draws = 0;
+        for (GameOutcome go : match.getOutcomes()) {
+            if (go.isDraw()) {
+                draws++;
+            }
+        }
+        sb.append(" | draws ").append(draws);
+        System.out.println(sb);
+    }
