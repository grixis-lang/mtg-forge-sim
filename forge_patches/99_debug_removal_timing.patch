diff --git a/forge-ai/src/main/java/forge/ai/AiDebug.java b/forge-ai/src/main/java/forge/ai/AiDebug.java
new file mode 100644
index 00000000..0f7b170d
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/AiDebug.java
@@ -0,0 +1,28 @@
+package forge.ai;
+
+import java.util.Set;
+
+import forge.game.phase.PhaseHandler;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+
+/**
+ * TEMPORARY debug (sim patch 99, log only): prints "AIDEBUG ..." lines for the control decks' removal spells, so the
+ * sim's log analysis can count why the AI holds them. Real games only, never the AI's simulated copies.
+ */
+public final class AiDebug {
+    private static final Set<String> WATCH = Set.of("Get Lost", "Erode", "Feed the Cycle", "Day of Judgment",
+            "Deadly Cover-Up", "Seam Rip");
+
+    private AiDebug() { }
+
+    public static void line(final Player ai, final SpellAbility sa, final String what) {
+        if (ai == null || sa == null || sa.getHostCard() == null || ai.getGame() == null
+                || ai.getGame().isSimulationCopy() || !WATCH.contains(sa.getHostCard().getName())) {
+            return;
+        }
+        final PhaseHandler ph = ai.getGame().getPhaseHandler();
+        System.out.println("AIDEBUG " + sa.getHostCard().getName() + " | " + (ph.isPlayerTurn(ai) ? "our " : "their ")
+                + ph.getPhase() + " | " + what);
+    }
+}
