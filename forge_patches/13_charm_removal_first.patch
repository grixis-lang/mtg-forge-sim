+    // Patch 13: is this charm mode a removal effect aimed at a target on the battlefield?
+    private static boolean isRemovalMode(AbilitySub sub) {
+        ApiType api = sub.getApi();
+        if (api == null || !sub.usesTargeting()) {
+            return false;
+        }
+        if (api == ApiType.Destroy || api == ApiType.DealDamage) {
+            return true;
+        }
+        if (api == ApiType.ChangeZone && "Battlefield".equals(sub.getParam("Origin"))) {
+            String dest = sub.getParam("Destination");
+            return "Exile".equals(dest) || "Graveyard".equals(dest) || "Hand".equals(dest) || "Library".equals(dest);
+        }
+        return false;
+    }
