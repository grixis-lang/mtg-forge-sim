diff --git a/forge-ai/src/main/java/forge/ai/BlightChoice.java b/forge-ai/src/main/java/forge/ai/BlightChoice.java
new file mode 100644
index 0000000..9436374
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/BlightChoice.java
@@ -0,0 +1,84 @@
+package forge.ai;
+
+// ---------------------------------------------------------------------------
+// Imports
+// ---------------------------------------------------------------------------
+import forge.game.card.Card;
+import forge.game.combat.Combat;
+import forge.game.keyword.Keyword;
+import forge.game.player.Player;
+
+/**
+ * "Blight only when the creature has already done its job" (AI profile property
+ * BLIGHT_ONLY_WHEN_SPENT=true). Used for optional blight costs like Requiting Hex
+ * ("you may blight 1": put a -1/-1 counter on a creature you control to gain 2 life).
+ *
+ * The user's rule (rule 4 in notes/how_we_play_control.md): pay the blight when the
+ * creature that takes the -1/-1 counter has already done its job - e.g. our 1/1 has
+ * already blocked. Once a creature is declared as a blocker, the attacker stays
+ * "blocked" even if the blocker dies, so it deals no damage to us (unless it has
+ * trample - then the damage would go through to us, so that blocker is NOT spent).
+ * Otherwise don't pay the blight; just cast the spell without it.
+ *
+ * Off by default (Forge's default AI always pays an optional cost if it can).
+ */
+public final class BlightChoice {
+
+    private BlightChoice() {
+    }
+
+    // -----------------------------------------------------------------------
+    // 1. Is the rule switched on for this player's AI profile?
+    // -----------------------------------------------------------------------
+    public static boolean isEnabled(final Player ai) {
+        return ai.getController() instanceof PlayerControllerAi pc
+                && pc.getAi().getBoolProperty(AiProps.BLIGHT_ONLY_WHEN_SPENT);
+    }
+
+    // -----------------------------------------------------------------------
+    // 2. A creature of ours that has already done its job, or null:
+    //    - it is blocking right now (blockers have been declared), and
+    //    - none of the attackers it blocks has trample (so killing our blocker
+    //      lets no damage through), and
+    //    - it would die in this combat anyway (the attackers' power is at least
+    //      its toughness), or it's a token (no card is lost).
+    //    Among several, the least valuable one (tokens first).
+    // -----------------------------------------------------------------------
+    public static Card spentCreature(final Player ai) {
+        final Combat combat = ai.getGame().getCombat();
+        if (combat == null) {
+            return null;
+        }
+        Card best = null;
+        for (final Card c : ai.getCreaturesInPlay()) {
+            if (!combat.isBlocking(c)) {
+                continue;
+            }
+            int incoming = 0;
+            boolean trample = false;
+            for (final Card attacker : combat.getAttackersBlockedBy(c)) {
+                incoming += Math.max(0, attacker.getNetCombatDamage());
+                trample |= attacker.hasKeyword(Keyword.TRAMPLE);
+            }
+            if (trample) {
+                continue;   // removing this blocker would let the damage trample over to us
+            }
+            final boolean diesAnyway = incoming >= c.getNetToughness();
+            if (!diesAnyway && !c.isToken()) {
+                continue;   // it survives this combat and still has a job to do
+            }
+            if (best == null || isLessValuable(c, best)) {
+                best = c;
+            }
+        }
+        return best;
+    }
+
+    // tokens before cards, then the weaker creature
+    private static boolean isLessValuable(final Card a, final Card b) {
+        if (a.isToken() != b.isToken()) {
+            return a.isToken();
+        }
+        return ComputerUtilCard.evaluateCreature(a) < ComputerUtilCard.evaluateCreature(b);
+    }
+}
