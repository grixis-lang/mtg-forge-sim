diff --git a/forge-ai/src/main/java/forge/ai/OpponentHandMemory.java b/forge-ai/src/main/java/forge/ai/OpponentHandMemory.java
new file mode 100644
index 0000000..b209582
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/OpponentHandMemory.java
@@ -0,0 +1,199 @@
+package forge.ai;
+
+// ---------------------------------------------------------------------------
+// Imports
+// ---------------------------------------------------------------------------
+import java.util.EnumSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+
+import forge.game.ability.ApiType;
+import forge.game.card.Card;
+import forge.game.card.CardCollection;
+import forge.game.card.CardCollectionView;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.spellability.TargetRestrictions;
+import forge.game.zone.ZoneType;
+
+/**
+ * "Remember what Duress showed" (AI profile property REMEMBER_OPPONENT_HAND=true).
+ *
+ * How a control player uses a look at the opponent's hand:
+ *   1. Remember it. Those cards stay known until they leave the opponent's hand.
+ *      (Forge's own REVEALED_CARDS memory is wiped at the end of every turn,
+ *      and the look-ahead rollouts ignored it, so the AI forgot right away.)
+ *   2. Plan with it. The look-ahead games keep the known cards in the
+ *      opponent's hand instead of reshuffling them, so "hold up a counter?",
+ *      "save the removal?" and "safe to tap out?" are judged against what the
+ *      opponent really holds. (Used by simulation.HiddenInfoShuffler.)
+ *   3. Compare hands when choosing what to take: take the card that OUR hand
+ *      can't answer. If we already hold a counterspell or removal that handles
+ *      a card, it's less urgent to take it.
+ *   4. Don't waste disruption: if we know the whole opposing hand and nothing
+ *      in it can be taken, don't cast another Duress.
+ *
+ * Off by default, so only decks whose profile turns it on are affected.
+ */
+public final class OpponentHandMemory {
+
+    // card ids we have seen in each opponent's hand (key: opponent's player id)
+    private final Map<Integer, Set<Integer>> seen = new ConcurrentHashMap<>();
+
+    // effects that count as "an answer" to a creature or permanent once it is on the battlefield
+    private static final Set<ApiType> REMOVAL = EnumSet.of(ApiType.Destroy, ApiType.DestroyAll,
+            ApiType.ChangeZone, ApiType.ChangeZoneAll, ApiType.Sacrifice, ApiType.SacrificeAll,
+            ApiType.DealDamage, ApiType.DamageAll);
+
+    // -----------------------------------------------------------------------
+    // 1. Getting the memory of an AI player (null when the setting is off)
+    // -----------------------------------------------------------------------
+    public static OpponentHandMemory of(final Player ai) {
+        if (ai == null || !(ai.getController() instanceof PlayerControllerAi pc)) {
+            return null;
+        }
+        final AiController brains = pc.getAi();
+        return brains.getBoolProperty(AiProps.REMEMBER_OPPONENT_HAND) ? brains.getOpponentHandMemory() : null;
+    }
+
+    // -----------------------------------------------------------------------
+    // 2. Remembering: called whenever cards are revealed to (or looked at by)
+    //    the AI. Only cards that are in an opponent's hand right now are kept.
+    // -----------------------------------------------------------------------
+    public void note(final Player ai, final Iterable<Card> cards) {
+        if (cards == null) {
+            return;
+        }
+        for (final Card c : cards) {
+            if (c == null || !c.isInZone(ZoneType.Hand)) {
+                continue;
+            }
+            final Player owner = c.getOwner();
+            if (owner != null && owner.isOpponentOf(ai)) {
+                seen.computeIfAbsent(owner.getId(), k -> ConcurrentHashMap.newKeySet()).add(c.getId());
+            }
+        }
+    }
+
+    // -----------------------------------------------------------------------
+    // 3. What we know: the remembered cards still in that opponent's hand.
+    //    (Cards that were cast or discarded since then drop out by themselves.)
+    // -----------------------------------------------------------------------
+    public boolean knows(final Card c) {
+        if (c == null || c.getOwner() == null || !c.isInZone(ZoneType.Hand)) {
+            return false;
+        }
+        final Set<Integer> ids = seen.get(c.getOwner().getId());
+        return ids != null && ids.contains(c.getId());
+    }
+
+    public CardCollection known(final Player opp) {
+        final CardCollection result = new CardCollection();
+        for (final Card c : opp.getCardsIn(ZoneType.Hand)) {
+            if (knows(c)) {
+                result.add(c);
+            }
+        }
+        return result;
+    }
+
+    public boolean knowsWholeHand(final Player opp) {
+        final CardCollectionView hand = opp.getCardsIn(ZoneType.Hand);
+        return !hand.isEmpty() && known(opp).size() == hand.size();
+    }
+
+    // Static shortcut used by the look-ahead shuffler: does this AI know this card?
+    public static boolean aiKnows(final Player ai, final Card c) {
+        final OpponentHandMemory mem = of(ai);
+        return mem != null && mem.knows(c);
+    }
+
+    // -----------------------------------------------------------------------
+    // 4. Comparing hands: can something in OUR hand answer this card later?
+    //    - a counterspell that is allowed to target it (when it is cast), or
+    //    - removal that is allowed to target it (once it is on the battlefield).
+    // -----------------------------------------------------------------------
+    public static boolean ourHandAnswers(final Player ai, final Card threat) {
+        for (final Card ours : ai.getCardsIn(ZoneType.Hand)) {
+            for (final SpellAbility sa : ours.getSpellAbilities()) {
+                if (sa.getApi() == null) {
+                    continue;
+                }
+                final TargetRestrictions tr = sa.getTargetRestrictions();
+                if (sa.getApi() == ApiType.Counter) {
+                    // e.g. No More Lies "Card" (any spell); Negate "Card.nonCreature"
+                    if (tr == null || threat.isValid(tr.getValidTgts(), ai, ours, sa)) {
+                        return true;
+                    }
+                } else if (REMOVAL.contains(sa.getApi()) && threat.isPermanent()) {
+                    if (tr == null) {
+                        // untargeted ("destroy all creatures"): only counts against creatures
+                        if (threat.isCreature() && (sa.getApi() == ApiType.DestroyAll || sa.getApi() == ApiType.DamageAll)) {
+                            return true;
+                        }
+                    } else if (!ai.equals(threat.getOwner()) && threat.isValid(tr.getValidTgts(), ai, ours, sa)) {
+                        return true;
+                    }
+                }
+            }
+        }
+        return false;
+    }
+
+    // -----------------------------------------------------------------------
+    // 5. Choosing what to take with Duress / Soul Search: the most dangerous
+    //    card that our own hand can NOT answer. Rough danger score:
+    //    mana value, plus a bonus by card type (planeswalkers and creatures
+    //    first), minus a lot if we already hold an answer to it.
+    // -----------------------------------------------------------------------
+    public static Card bestToTake(final Player ai, final Iterable<Card> options) {
+        Card best = null;
+        int bestScore = Integer.MIN_VALUE;
+        for (final Card c : options) {
+            int score = c.getCMC() * 10;
+            if (c.isPlaneswalker()) {
+                score += 40;
+            } else if (c.isCreature()) {
+                score += 25;
+            } else if (c.isEnchantment() || c.isArtifact()) {
+                score += 20;   // e.g. equipment and engines that stick around
+            } else {
+                score += 10;   // instants and sorceries
+            }
+            if (ourHandAnswers(ai, c)) {
+                score -= 45;   // we can deal with it later: take something else
+            }
+            if (score > bestScore) {
+                bestScore = score;
+                best = c;
+            }
+        }
+        return best;
+    }
+
+    // -----------------------------------------------------------------------
+    // 6. "Is it worth it?": a hand-disruption spell is pointless when we know
+    //    every card in the opponent's hand and none of them can be taken
+    //    (e.g. Duress against a hand of only creatures and lands).
+    // -----------------------------------------------------------------------
+    public static boolean pointless(final Player ai, final SpellAbility sa) {
+        final OpponentHandMemory mem = of(ai);
+        if (mem == null) {
+            return false;
+        }
+        final String valid = sa.hasParam("DiscardValid") ? sa.getParam("DiscardValid")
+                : sa.getParamOrDefault("ChangeType", "Card");
+        for (final Player opp : ai.getOpponents()) {
+            if (!mem.knowsWholeHand(opp)) {
+                return false;   // there may be something we haven't seen
+            }
+            for (final Card c : opp.getCardsIn(ZoneType.Hand)) {
+                if (c.isValid(valid.split(","), ai, sa.getHostCard(), sa)) {
+                    return false;   // there is something to take
+                }
+            }
+        }
+        return true;
+    }
+}
