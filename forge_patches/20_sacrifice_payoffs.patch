index 00000000..3bcb4b30
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/SacPayoff.java
@@ -0,0 +1,161 @@
+package forge.ai;
+
+import forge.game.Game;
+import forge.game.ability.AbilityUtils;
+import forge.game.ability.ApiType;
+import forge.game.card.Card;
+import forge.game.card.CardCollection;
+import forge.game.card.CardLists;
+import forge.game.phase.PhaseHandler;
+import forge.game.phase.PhaseType;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.trigger.Trigger;
+import forge.game.trigger.TriggerType;
+import forge.game.zone.ZoneType;
+
+/**
+ * Sim fix (patch 20), profile setting SAC_PAYOFF_SMART: which token to sacrifice for a "sacrifice another creature or
+ * artifact" cost in sacrifice decks (Jund Biotech: Biotech Specialist deals 2 damage whenever we sacrifice an artifact,
+ * The Sackville-Bagginses drains 1 whenever we sacrifice a token, Umbral Collar Zealot is a free sacrifice outlet).
+ *
+ * Forge's Hardest profile only sacrifices cards marked "SacMe" or about to die, so these decks almost never used their
+ * free outlet or the optional sacrifices. With the setting on, a token is used as fodder when:
+ *  1. the ability that needs it draws a card (The Sackville-Bagginses: sacrifice, draw and get a Treasure back);
+ *  2. sacrificing every token we have would deal lethal damage through our sacrifice payoffs; or
+ *  3. it is the opponent's end step and the token is a spare Treasure (more than we need to cast our hand next turn)
+ *     that our payoffs turn into damage.
+ * Otherwise this returns null and Forge's normal rules decide. Only tokens are offered, never real cards.
+ */
+public final class SacPayoff {
+    private SacPayoff() { }
+
+    /** A token we would sacrifice for this cost, or null to leave the choice to Forge. */
+    public static Card pickFodder(final Player ai, final Card activator, final CardCollection choices, final SpellAbility sa) {
+        if (ai == null || !AiProfileUtil.getBoolProperty(ai, AiProps.SAC_PAYOFF_SMART)) {
+            return null;
+        }
+        final int maxEval = AiProfileUtil.getIntProperty(ai, AiProps.SACRIFICE_DEFAULT_PREF_MAX_CREATURE_EVAL);
+        final CardCollection tokens = CardLists.filter(choices, c -> c.isToken() && !c.equals(activator)
+                && (!c.isCreature() || ComputerUtilCard.evaluateCreature(c) <= maxEval));
+        if (tokens.isEmpty()) {
+            return null;
+        }
+
+        // 1. sacrifice to draw a card: a token is cheap fodder
+        if (sa != null && drawsCard(sa)) {
+            return cheapest(tokens);
+        }
+
+        // 2./3. only tokens that our "whenever you sacrifice" cards turn into damage or life loss
+        final CardCollection paying = CardLists.filter(tokens, c -> payoff(ai, c) > 0);
+        if (paying.isEmpty()) {
+            return null;
+        }
+        final Player opp = ai.getWeakestOpponent();
+        if (opp == null) {
+            return null;
+        }
+        int total = 0;
+        for (final Card c : paying) {
+            total += payoff(ai, c);
+        }
+        if (opp.canLoseLife() && total >= opp.getLife()) {
+            return cheapest(paying); // it kills them: sacrifice everything
+        }
+
+        final Game game = ai.getGame();
+        final PhaseHandler ph = game.getPhaseHandler();
+        if (ph.is(PhaseType.END_OF_TURN) && ph.isPlayerNextTurn(ai)) {
+            final CardCollection treasures = CardLists.filter(paying, c -> c.getType().hasSubtype("Treasure"));
+            final int allTreasures = CardLists.count(ai.getCardsIn(ZoneType.Battlefield),
+                    c -> c.isToken() && c.getType().hasSubtype("Treasure"));
+            if (!treasures.isEmpty() && allTreasures > treasuresToKeep(ai)) {
+                return treasures.getFirst();
+            }
+        }
+        return null;
+    }
+
+    /** Damage or life loss our "whenever you sacrifice" triggers deal when this card is sacrificed. */
+    static int payoff(final Player ai, final Card fodder) {
+        int total = 0;
+        for (final Card source : ai.getCardsIn(ZoneType.Battlefield)) {
+            for (final Trigger t : source.getTriggers()) {
+                if (t.getMode() != TriggerType.Sacrificed) {
+                    continue;
+                }
+                if (t.hasParam("ValidPlayer") && !t.matchesValidParam("ValidPlayer", ai)) {
+                    continue;
+                }
+                if (t.hasParam("ValidCard") && !t.matchesValidParam("ValidCard", fodder)) {
+                    continue;
+                }
+                final SpellAbility effect = t.ensureAbility();
+                if (effect == null) {
+                    continue;
+                }
+                if (effect.getApi() == ApiType.DealDamage && effect.hasParam("NumDmg")) {
+                    total += Math.max(0, AbilityUtils.calculateAmount(source, effect.getParam("NumDmg"), effect));
+                } else if (effect.getApi() == ApiType.LoseLife && effect.hasParam("LifeAmount")) {
+                    total += Math.max(0, AbilityUtils.calculateAmount(source, effect.getParam("LifeAmount"), effect));
+                }
+            }
+        }
+        return total;
+    }
+
+    /** Treasures to keep: enough to cast the most expensive spell in hand next turn, more if a card spends Treasures. */
+    private static int treasuresToKeep(final Player ai) {
+        int maxCmc = 0;
+        for (final Card c : ai.getCardsIn(ZoneType.Hand)) {
+            if (!c.isLand()) {
+                maxCmc = Math.max(maxCmc, c.getCMC());
+            }
+        }
+        final boolean landInHand = CardLists.count(ai.getCardsIn(ZoneType.Hand), Card::isLand) > 0;
+        final int lands = ai.getLandsInPlay().size() + (landInHand ? 1 : 0);
+        int keep = Math.max(0, maxCmc - lands);
+        for (final Card c : ai.getCardsIn(ZoneType.Battlefield)) {
+            if (c.isToken()) {
+                continue;
+            }
+            for (final SpellAbility ab : c.getSpellAbilities()) {
+                if (ab.getPayCosts() != null && ab.getPayCosts().toString().contains("Treasure")) {
+                    keep += 3; // Magda and the like turn Treasures into something bigger
+                }
+            }
+        }
+        return keep;
+    }
+
+    private static boolean drawsCard(final SpellAbility sa) {
+        for (SpellAbility s = sa; s != null; s = s.getSubAbility()) {
+            if (s.getApi() == ApiType.Draw) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /** Cheapest token to give up: Treasures, then other non-creature tokens, then the weakest creature token. */
+    private static Card cheapest(final CardCollection tokens) {
+        Card best = null;
+        int bestScore = Integer.MAX_VALUE;
+        for (final Card c : tokens) {
+            int score;
+            if (c.getType().hasSubtype("Treasure")) {
+                score = 0;
+            } else if (!c.isCreature()) {
+                score = 10;
+            } else {
+                score = 20 + ComputerUtilCard.evaluateCreature(c);
+            }
+            if (score < bestScore) {
+                bestScore = score;
+                best = c;
+            }
+        }
+        return best;
+    }
+}
