+    /** Sim fix (patch 18): true if a castable spot removal spell in our hand (destroy, exile/bounce, damage) can target this card. */
+    private static boolean holdsSpotRemovalFor(final Player ai, final Card target, final SpellAbility wipe) {
+        for (final Card card : ai.getCardsIn(ZoneType.Hand)) {
+            if (card.equals(wipe.getHostCard())) {
+                continue;
+            }
+            for (final SpellAbility spell : card.getSpells()) {
+                final ApiType api = spell.getApi();
+                if (api != ApiType.Destroy && api != ApiType.ChangeZone && api != ApiType.DealDamage) {
+                    continue;
+                }
+                if (!spell.usesTargeting()) {
+                    continue;
+                }
+                spell.setActivatingPlayer(ai);
+                if (spell.canTarget(target) && ComputerUtilMana.canPayManaCost(spell, ai, 0, false)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
