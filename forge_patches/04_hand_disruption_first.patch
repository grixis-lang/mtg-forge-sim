diff --git a/forge-ai/src/main/java/forge/ai/HandDisruption.java b/forge-ai/src/main/java/forge/ai/HandDisruption.java
new file mode 100644
index 00000000..0d3abe15
--- /dev/null
+++ b/forge-ai/src/main/java/forge/ai/HandDisruption.java
@@ -0,0 +1,119 @@
+package forge.ai;
+
+// ---------------------------------------------------------------------------
+// Imports
+// ---------------------------------------------------------------------------
+import java.util.List;
+import java.util.function.Predicate;
+
+import forge.game.ability.ApiType;
+import forge.game.card.Card;
+import forge.game.player.Player;
+import forge.game.spellability.SpellAbility;
+import forge.game.zone.ZoneType;
+
+/**
+ * "Hand disruption first" for control decks (AI profile property PRIORITIZE_HAND_DISRUPTION=true).
+ *
+ * The rule, as a player would say it:
+ *   1. If a hand-disruption spell (Duress, Soul Search, ...) can be cast on our own turn, cast it:
+ *      turn 1 Duress, turn 2 Soul Search, always.
+ *   2. Only keep mana open for instants (counterspells, instant removal) when there is no
+ *      hand-disruption spell left to cast.
+ *
+ * Without this, a profile that likes holding mana (high FLAT_MC_HOLD_MANA_WEIGHT) often skips the
+ * sorcery to keep a counterspell up, and then has nothing worth countering: the turn is wasted.
+ *
+ * Off by default, so only decks whose profile turns it on are affected.
+ */
+public final class HandDisruption {
+
+    private HandDisruption() {
+    }
+
+    // -----------------------------------------------------------------------
+    // 1. Is the rule switched on for this player's AI profile?
+    // -----------------------------------------------------------------------
+    public static boolean isEnabled(final Player player) {
+        if (!(player.getController() instanceof PlayerControllerAi pc)) {
+            return false;
+        }
+        return pc.getAi().getBoolProperty(AiProps.PRIORITIZE_HAND_DISRUPTION);
+    }
+
+    // -----------------------------------------------------------------------
+    // 2. What counts as hand disruption: a spell that makes an opponent
+    //    discard, or that takes a card from an opponent's hand
+    //    (e.g. Duress = Discard, Soul Search = ChangeZone from Hand to Exile).
+    // -----------------------------------------------------------------------
+    public static boolean isHandDisruption(final SpellAbility sa) {
+        if (sa == null || !sa.isSpell() || sa.getApi() == null) {
+            return false;
+        }
+        final String targets = sa.getParamOrDefault("ValidTgts", "");
+        final boolean aimsAtOpponent = targets.contains("Opponent")
+                || "Opponent".equals(sa.getParamOrDefault("Defined", ""));
+        if (!aimsAtOpponent) {
+            return false;
+        }
+        if (sa.getApi() == ApiType.Discard) {
+            return true;
+        }
+        return sa.getApi() == ApiType.ChangeZone
+                && "Hand".equals(sa.getParamOrDefault("Origin", ""))
+                && !"Hand".equals(sa.getParamOrDefault("Destination", ""));
+    }
+
+    // -----------------------------------------------------------------------
+    // 3. Is there anything to take? (an empty opposing hand = nothing to gain)
+    // -----------------------------------------------------------------------
+    private static boolean opponentHasCards(final Player player) {
+        for (final Player opp : player.getOpponents()) {
+            if (!opp.getCardsIn(ZoneType.Hand).isEmpty()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // -----------------------------------------------------------------------
+    // 4. Used by the "hold mana?" check: true when a hand-disruption spell in
+    //    hand could be cast with the mana we have right now (so holding mana
+    //    for an instant is not allowed this turn).
+    // -----------------------------------------------------------------------
+    public static boolean hasCastableInHand(final Player player, final int availableMana) {
+        if (!isEnabled(player) || !opponentHasCards(player)) {
+            return false;
+        }
+        for (final Card c : player.getCardsIn(ZoneType.Hand)) {
+            if (c.isLand() || c.getCMC() > availableMana) {
+                continue;
+            }
+            for (final SpellAbility sa : c.getSpellAbilities()) {
+                if (isHandDisruption(sa)) {
+                    return true;
+                }
+            }
+        }
+        return false;
+    }
+
+    // -----------------------------------------------------------------------
+    // 5. Used on our own main phase with an empty stack: the first
+    //    hand-disruption spell the AI is willing (and able) to cast, or null.
+    //    "approved" is the AI's normal can-play-and-pay check, so targets
+    //    and costs are set up exactly as for any other play.
+    // -----------------------------------------------------------------------
+    public static SpellAbility firstPlayable(final Player player, final List<SpellAbility> plays,
+                                             final Predicate<SpellAbility> approved) {
+        if (!isEnabled(player) || !opponentHasCards(player)) {
+            return null;
+        }
+        for (final SpellAbility sa : plays) {
+            if (isHandDisruption(sa) && approved.test(sa)) {
+                return sa;
+            }
+        }
+        return null;
+    }
+}
